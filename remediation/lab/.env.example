# =====================================================================
# SIG-TEC · configuración local (plantilla)
# scripts/setup.sh crea .env a partir de este archivo y genera contraseñas
# aleatorias para cada variable con valor "__GENERAR__".
# .env NO se versiona (ver .gitignore). No escriba contraseñas reales aquí.
# =====================================================================

COMPOSE_PROJECT_NAME=sigtec_remed
SIGTEC_IMAGE=sigtec-remed/postgis:17.12-3.5.4

# Dirección donde se publican los puertos. 127.0.0.1 = solo esta máquina.
# Use 0.0.0.0 únicamente si QGIS corre en otra máquina (y proteja la red).
SIGTEC_BIND_ADDRESS=127.0.0.1

SIGTEC_PORT_CENTRAL=57430
SIGTEC_PORT_CARTAGO=57431
SIGTEC_PORT_SAN_JOSE=57432
SIGTEC_PORT_SAN_CARLOS=57433
SIGTEC_PORT_ALAJUELA=57434
SIGTEC_PORT_LIMON=57435
SIGTEC_PORT_RECOVERY=57436

# Superusuario "postgres" de los seis nodos (administración, migraciones).
POSTGRES_PASSWORD=__GENERAR__

# Rol de respaldo sigtec_backup (pg_dump / pg_basebackup; solo lectura + REPLICATION).
SIGTEC_BACKUP_PASSWORD=__GENERAR__

# Contraseñas de las cuentas de prueba del contrato técnico (sección 4).
# El Integrante 1 solo las GENERA; las cuentas las crea el Integrante 3 (auth).
SIGTEC_QGIS_CARTAGO_PASSWORD=__GENERAR__
SIGTEC_QGIS_SAN_JOSE_PASSWORD=__GENERAR__
SIGTEC_QGIS_SAN_CARLOS_PASSWORD=__GENERAR__
SIGTEC_QGIS_ALAJUELA_PASSWORD=__GENERAR__
SIGTEC_QGIS_LIMON_PASSWORD=__GENERAR__
