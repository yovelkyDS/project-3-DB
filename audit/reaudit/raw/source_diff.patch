-SELECT coalesce(pg_sequence_last_value(:'seq'::regclass), 0) AS antes,
-       (:max_id::bigint - :campus_id::bigint * 1000000000)    AS consecutivo_central;
+-- Desde la migración 0103 también se considera el registro ops.identificadores_globales
+-- (ids emitidos en este nodo, incluidos los de objetos eliminados).
+SELECT coalesce(pg_sequence_last_value(:'seq'::regclass), 0)                          AS antes,
+       (:max_id::bigint - :campus_id::bigint * 1000000000)                            AS consecutivo_central,
+       (SELECT coalesce(max(id), 0) - :campus_id::bigint * 1000000000
+          FROM ops.identificadores_globales WHERE campus_id = :campus_id)             AS consecutivo_registro;
 
